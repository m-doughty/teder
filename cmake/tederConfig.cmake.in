@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT WIN32)
	find_dependency(Threads)
endif()
if(NOT @BUILD_SHARED_LIBS@ AND NOT TARGET teder::flac)
	add_library(teder::flac STATIC IMPORTED)
	set_target_properties(teder::flac PROPERTIES IMPORTED_LOCATION
		"@PACKAGE_CMAKE_INSTALL_LIBDIR@/teder/@CMAKE_STATIC_LIBRARY_PREFIX@FLAC@CMAKE_STATIC_LIBRARY_SUFFIX@")
	if(WIN32 AND NOT MSVC AND "@HAVE_LIBSSP@")
		set_property(TARGET teder::flac PROPERTY INTERFACE_LINK_LIBRARIES ssp)
	elseif(NOT WIN32)
		set_property(TARGET teder::flac PROPERTY INTERFACE_LINK_LIBRARIES m)
	endif()
endif()
if(@TEDER_WITH_NOTCURSES@ AND NOT @BUILD_SHARED_LIBS@ AND NOT TARGET teder::notcurses_runtime)
	# Consumers explicitly provide the same fork runtime; never substitute a stock library.
	if(NOT TEDER_NOTCURSES_LIBRARY)
		set(teder_FOUND FALSE)
		set(teder_NOT_FOUND_MESSAGE "Set TEDER_NOTCURSES_LIBRARY to the matching fork's core library")
		return()
	endif()
	add_library(teder::notcurses_runtime UNKNOWN IMPORTED)
	set_property(TARGET teder::notcurses_runtime PROPERTY IMPORTED_LOCATION "${TEDER_NOTCURSES_LIBRARY}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/tederTargets.cmake")
check_required_components(teder)
