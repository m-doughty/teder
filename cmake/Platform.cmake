if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
	message(FATAL_ERROR "teder v1 requires a 64-bit target; see docs/build.md")
endif()
if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Windows|Linux|Darwin)$")
	message(FATAL_ERROR "teder v1 targets Windows, Linux and macOS")
endif()
if(NOT CMAKE_C_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang|MSVC)$")
	message(FATAL_ERROR "Unsupported compiler; see docs/build.md")
endif()
include(TestBigEndian)
test_big_endian(teder_big_endian)
if(teder_big_endian)
	message(FATAL_ERROR "teder v1 supports little-endian targets")
endif()
if(NOT TEDER_SANITIZER MATCHES "^(none|address|thread)$")
	message(FATAL_ERROR "TEDER_SANITIZER must be none, address or thread; use separate build directories")
endif()
if(NOT TEDER_SANITIZER STREQUAL "none")
	if(WIN32 OR MSVC)
		message(FATAL_ERROR "teder sanitizer configurations require Linux/macOS GCC or Clang")
	endif()
	if(TEDER_SANITIZER STREQUAL "address")
		set(teder_sanitizer_flags -fsanitize=address,undefined -fno-sanitize-recover=all)
	else()
		set(teder_sanitizer_flags -fsanitize=thread)
	endif()
	include(CheckCSourceCompiles)
	set(CMAKE_REQUIRED_FLAGS "${teder_sanitizer_flags}")
	string(REPLACE ";" " " CMAKE_REQUIRED_FLAGS "${CMAKE_REQUIRED_FLAGS}")
	check_c_source_compiles("int main(void) { return 0; }" teder_sanitizer_links)
	unset(CMAKE_REQUIRED_FLAGS)
	if(NOT teder_sanitizer_links)
		message(FATAL_ERROR "Selected sanitizer cannot compile/link with this toolchain")
	endif()
	add_compile_options(${teder_sanitizer_flags} -fno-omit-frame-pointer)
	add_link_options(${teder_sanitizer_flags})
endif()
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_package(Threads REQUIRED)
include(CheckCSourceCompiles)
include(CMakePushCheckState)
cmake_push_check_state(RESET)
if(MSVC)
	set(CMAKE_REQUIRED_FLAGS "/experimental:c11atomics")
endif()
check_c_source_compiles("#include <stdatomic.h>\n_Static_assert(ATOMIC_INT_LOCK_FREE == 2, \"lock-free unsigned atomics required\");\nint main(void) { atomic_uint x; atomic_init(&x, 1); unsigned n = 1; return !atomic_compare_exchange_strong(&x, &n, 2); }" teder_c17_atomics)
cmake_pop_check_state()
if(NOT teder_c17_atomics)
	message(FATAL_ERROR "teder requires C17 stdatomic.h and lock-free unsigned atomics; MSVC needs /experimental:c11atomics")
endif()
