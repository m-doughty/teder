# Audit source objects for the file-information fault hook. The library's objects
# must not reference it; with EXPECT_HOOK, the test copy must. OBJECTS is |-separated.
string(REPLACE "|" ";" objects "${OBJECTS}")
set(found "")
foreach(object IN LISTS objects)
	execute_process(COMMAND "${NM}" "${object}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(NOT code EQUAL 0)
		message(FATAL_ERROR "Fault-hook audit failed to run on ${object}: ${error}")
	endif()
	string(REPLACE "\n" ";" lines "${output}")
	foreach(line IN LISTS lines)
		string(STRIP "${line}" line)
		string(REGEX REPLACE "^.*[ \t]" "" symbol "${line}")
		if(symbol MATCHES "^_?td_file_fault$")
			list(APPEND found "${object}")
		endif()
	endforeach()
endforeach()
if(EXPECT_HOOK AND NOT found)
	message(FATAL_ERROR "No fault-hook object references td_file_fault: ${OBJECTS}")
elseif(NOT EXPECT_HOOK AND found)
	message(FATAL_ERROR "Library source objects reference the test-only fault hook: ${found}")
endif()
if(found)
	message(STATUS "Fault-hook references in: ${found}")
else()
	message(STATUS "No source object references the fault hook")
endif()
