cmake_minimum_required(VERSION 3.25)
execute_process(COMMAND "${NM}" -u "${OBJECT}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0)
	message(FATAL_ERROR "libFLAC allocation audit failed to run: ${error}")
endif()
string(REPLACE "\n" ";" lines "${output}")
set(rejected "")
set(adapters "")
foreach(line IN LISTS lines)
	string(STRIP "${line}" line)
	if(line MATCHES "[ \t]U[ \t]+([^ \t]+)$" OR line MATCHES "^U[ \t]+([^ \t]+)$")
		set(symbol "${CMAKE_MATCH_1}")
	elseif(line MATCHES "^[_A-Za-z][_A-Za-z0-9@]*$")
		# Apple nm -u prints symbol-only lines; archive member labels end in ':'.
		set(symbol "${line}")
	else()
		continue()
	endif()
	string(REGEX REPLACE "^__imp_" "" symbol "${symbol}")
	string(REGEX REPLACE "^_+" "" symbol "${symbol}")
	string(REGEX REPLACE "@[0-9]+$" "" symbol "${symbol}")
	if(symbol MATCHES "^(malloc|calloc|realloc|reallocarray|free|strdup|strndup|wcsdup|aligned_alloc|aligned_malloc|aligned_realloc|aligned_free|posix_memalign|memalign|valloc|HeapAlloc|HeapReAlloc|HeapFree|LocalAlloc|LocalReAlloc|LocalFree|GlobalAlloc|GlobalReAlloc|GlobalFree|VirtualAlloc|VirtualFree)$")
		list(APPEND rejected "${symbol}")
	elseif(symbol MATCHES "^td_flac_(malloc|calloc|realloc|free|strdup)$")
		list(APPEND adapters "${symbol}")
	endif()
endforeach()
if(EXPECT_REJECTION)
	if(NOT "free" IN_LIST rejected)
		message(FATAL_ERROR "Allocation audit did not reject the deliberate free dependency")
	endif()
	message(STATUS "Allocation audit rejected deliberate free")
else()
	if(rejected)
		message(FATAL_ERROR "Unaccounted libFLAC allocation dependencies: ${rejected}")
	endif()
	foreach(symbol td_flac_malloc td_flac_calloc td_flac_realloc td_flac_free td_flac_strdup)
		if(NOT symbol IN_LIST adapters)
			message(FATAL_ERROR "Missing libFLAC allocation adapter: ${symbol}")
		endif()
	endforeach()
	message(STATUS "Private libFLAC uses all five allocation adapters; no direct heap imports")
endif()
